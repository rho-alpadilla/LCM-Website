NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Turnstile site key. Use Cloudflare's documented test site key only for
# local development; replace it with the church widget's site key before deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Turnstile configuration. Store TURNSTILE_SECRET in .env.local for
# local development and as a Wrangler secret for deployed environments.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Non-secret Cloudflare Access configuration. These stay blank until the
# preview or production Access application is configured.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# External integrations are intentionally disconnected during scaffolding.
# Cloudflare D1/R2 bindings are configured in wrangler.jsonc, not stored here as secrets.
RESEND_API_KEY=

# Server-only PayMongo test credentials. Keep these in .env.local during local
# development and as Wrangler secrets after deployment. Never use NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=test
