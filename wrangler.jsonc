{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifechangers-ministry-web",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENVIRONMENT": "local",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "CLOUDFLARE_ACCESS_ACCOUNT_ID": "",
    "CLOUDFLARE_ACCESS_POLICY_ID": "",
    "STAFF_AUTH_MODE": "access",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifechangers-ministry-local",
      "migrations_dir": "migrations/d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "WEBSITE_FILES",
      "bucket_name": "lifechangers-ministry-local-files",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STAFF_AUTHENTICATION",
        "class_name": "StaffAuthenticationCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "staff-authentication-v1",
      "new_sqlite_classes": ["StaffAuthenticationCoordinator"],
    },
  ],
  "ratelimits": [
    {
      "name": "PRAYER_SUBMISSION_RATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "GIVING_CHECKOUT_RATE_LIMITER",
      "namespace_id": "1104",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
      "namespace_id": "1107",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": { "crons": ["15 18 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "preview": {
      "name": "lcm-website",
      "vars": {
        "APP_ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CLOUDFLARE_ACCESS_ACCOUNT_ID": "",
        "CLOUDFLARE_ACCESS_POLICY_ID": "",
        "STAFF_AUTH_MODE": "password",
        "TURNSTILE_HOSTNAMES": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifechangers-ministry-preview",
          "migrations_dir": "migrations/d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "WEBSITE_FILES",
          "bucket_name": "lifechangers-ministry-preview-files",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "STAFF_AUTHENTICATION",
            "class_name": "StaffAuthenticationCoordinator",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "PRAYER_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "GIVING_CHECKOUT_RATE_LIMITER",
          "namespace_id": "1105",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1108",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "triggers": { "crons": ["15 18 * * *"] },
    },
    "production": {
      "name": "lifechangers-ministry-web-production",
      "vars": {
        "APP_ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CLOUDFLARE_ACCESS_ACCOUNT_ID": "",
        "CLOUDFLARE_ACCESS_POLICY_ID": "",
        "STAFF_AUTH_MODE": "access",
        "TURNSTILE_HOSTNAMES": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifechangers-ministry-production",
          "migrations_dir": "migrations/d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "WEBSITE_FILES",
          "bucket_name": "lifechangers-ministry-production-files",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "STAFF_AUTHENTICATION",
            "class_name": "StaffAuthenticationCoordinator",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "PRAYER_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "GIVING_CHECKOUT_RATE_LIMITER",
          "namespace_id": "1106",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1109",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "triggers": { "crons": ["15 18 * * *"] },
    },
  },
}
