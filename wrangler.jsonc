{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifechangers-ministry-web",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENVIRONMENT": "local",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "CLOUDFLARE_ACCESS_ACCOUNT_ID": "",
    "CLOUDFLARE_ACCESS_POLICY_ID": "",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifechangers-ministry-local",
      "migrations_dir": "migrations/d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "WEBSITE_FILES",
      "bucket_name": "lifechangers-ministry-local-files",
    },
  ],
  "ratelimits": [
    {
      "name": "PRAYER_SUBMISSION_RATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "GIVING_CHECKOUT_RATE_LIMITER",
      "namespace_id": "1104",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
      "namespace_id": "1107",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": { "crons": ["15 18 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "preview": {
      "name": "lcm-website",
      "vars": {
        "APP_ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "https://muddy-queen-9afb.cloudflareaccess.com",
        "ACCESS_AUD": "e01d4ed2cef950a5e618cd93dbb8d5b68054c0c7c2fbba50a752bb5f57174dfe",
        "CLOUDFLARE_ACCESS_ACCOUNT_ID": "52c15bd60a71661efb865aeafdd1c493",
        "CLOUDFLARE_ACCESS_POLICY_ID": "15efabc5-cf0c-4207-aa54-dfe438e6e011",
        "TURNSTILE_HOSTNAMES": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifechangers-ministry-preview",
          "migrations_dir": "migrations/d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "WEBSITE_FILES",
          "bucket_name": "lifechangers-ministry-preview-files",
        },
      ],
      "ratelimits": [
        {
          "name": "PRAYER_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "GIVING_CHECKOUT_RATE_LIMITER",
          "namespace_id": "1105",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1108",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "triggers": { "crons": ["15 18 * * *"] },
    },
    "production": {
      "name": "lifechangers-ministry-web-production",
      "vars": {
        "APP_ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CLOUDFLARE_ACCESS_ACCOUNT_ID": "",
        "CLOUDFLARE_ACCESS_POLICY_ID": "",
        "TURNSTILE_HOSTNAMES": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifechangers-ministry-production",
          "migrations_dir": "migrations/d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "WEBSITE_FILES",
          "bucket_name": "lifechangers-ministry-production-files",
        },
      ],
      "ratelimits": [
        {
          "name": "PRAYER_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "GIVING_CHECKOUT_RATE_LIMITER",
          "namespace_id": "1106",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INQUIRY_SUBMISSION_RATE_LIMITER",
          "namespace_id": "1109",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "triggers": { "crons": ["15 18 * * *"] },
    },
  },
}
